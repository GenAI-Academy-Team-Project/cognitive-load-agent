# CLOUD runtime bindings. Copy to web/.secrets.cloudflare.
# Uploaded only by make cloud-secrets-apply, never loaded by the build.
# Calendar callback: https://YOUR_DEPLOYED_HOST/api/calendar/callback
# Configure a whole group or leave it blank. Blank values preserve remote secrets.
# Cloudflare API tokens belong in shell/CI secrets, not this file.
# Calendar: fill all four values to enable. Keep GOOGLE_TOKEN_KEY stable.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
# Generate once per environment: openssl rand -hex 32
GOOGLE_TOKEN_KEY=

# Email: configure both values (quote a sender display name).
RESEND_API_KEY=
NOTIFICATION_EMAIL_FROM=

# SMS: configure all three values.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Browser push: configure all three values; keep keys stable.
# Generate from web/: npx web-push generate-vapid-keys --json
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# Pushover application token. Each caregiver saves their user key in Notifications.
PUSHOVER_API_TOKEN=

# For untested integrations (OneSignal, OpenRouter, Mem0), see feature/untested-integrations
