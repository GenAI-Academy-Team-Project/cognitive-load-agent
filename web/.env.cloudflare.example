# Copy to .env.cloudflare; cloud commands load it automatically.
# Run make cloud-db-create once and paste its database UUID here.
CLOUDFLARE_D1_DATABASE_ID=REPLACE_WITH_D1_DATABASE_ID
CLOUDFLARE_WORKER_NAME=carestead
CLOUDFLARE_D1_DATABASE_NAME=carestead
# Optional when you have access to multiple Cloudflare accounts:
# CLOUDFLARE_ACCOUNT_ID=your-account-id
