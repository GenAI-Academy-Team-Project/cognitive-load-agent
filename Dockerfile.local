# Local Workers preview; production runs natively on Cloudflare Workers.
FROM node:22-bookworm-slim AS build
WORKDIR /app
ENV WRANGLER_SEND_METRICS=false WRANGLER_WRITE_LOGS=false
COPY web/package.json web/package-lock.json ./
RUN npm ci
COPY web/ ./
RUN npm run build

FROM node:22-bookworm-slim AS preview
WORKDIR /app
ENV NODE_ENV=production WRANGLER_SEND_METRICS=false WRANGLER_WRITE_LOGS=false
# Wrangler is required to execute the Workers bundle and emulate D1.
COPY --from=build --chown=node:node /app/node_modules ./node_modules
COPY --from=build --chown=node:node /app/package.json ./package.json
COPY --from=build --chown=node:node /app/dist ./dist
RUN mkdir -p /app/.wrangler/state && chown -R node:node /app/.wrangler
USER node
EXPOSE 8080
HEALTHCHECK --interval=30s --timeout=5s --start-period=30s --retries=3 \
  CMD node -e "fetch('http://127.0.0.1:8080/api/health').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"
CMD ["node", "node_modules/wrangler/bin/wrangler.js", "dev", "--config", "dist/server/wrangler.json", "--ip", "0.0.0.0", "--port", "8080", "--inspector-port", "0", "--persist-to", "/app/.wrangler/state"]
