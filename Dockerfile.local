# Local Workers preview; production runs natively on Cloudflare Workers.
FROM node:22-bookworm-slim AS build
WORKDIR /app
ENV WRANGLER_SEND_METRICS=false WRANGLER_WRITE_LOGS=false
COPY web/package.json web/package-lock.json ./
RUN npm ci
COPY web/ ./
RUN npm run build

FROM node:22-bookworm-slim AS preview
WORKDIR /app
ENV NODE_ENV=production WRANGLER_SEND_METRICS=false WRANGLER_WRITE_LOGS=false
# Wrangler is required to execute the Workers bundle and emulate D1.
COPY --from=build --chown=node:node /app/node_modules ./node_modules
COPY --from=build --chown=node:node /app/package.json ./package.json
COPY --from=build --chown=node:node /app/dist ./dist
COPY --chown=node:node web/scripts/local-server.mjs ./scripts/local-server.mjs
RUN mkdir -p /app/.wrangler/state && chown -R node:node /app/.wrangler
USER node
EXPOSE 8080 8083
HEALTHCHECK --interval=30s --timeout=5s --start-period=30s --retries=3 \
  CMD node -e "require('http').get('http://127.0.0.1:8080/api/health',r=>{if([307,308].includes(r.statusCode))require('https').get('https://127.0.0.1:8083/api/health',{rejectUnauthorized:false},s=>process.exit(s.statusCode===200?0:1)).on('error',()=>process.exit(1));else process.exit(r.statusCode===200?0:1)}).on('error',()=>process.exit(1))"
ENV CARESTEAD_CONTAINER=1
CMD ["npm", "run", "start"]
