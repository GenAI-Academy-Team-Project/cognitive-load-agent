{
  "name": "carestead-mobile",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "mac:gateway": "node scripts/mac-gateway.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:e2e": "playwright test",
    "ios:prepare": "npm run build && node scripts/prepare-ios.mjs",
    "ios:open": "cap open ios",
    "check:preservation": "node scripts/preservation.mjs check"
  },
  "dependencies": {
    "@base-ui/react": "1.7.0",
    "@capacitor/core": "8.5.2",
    "@capacitor/ios": "8.5.2",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.31.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "tailwind-merge": "3.6.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.4.3",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "shadcn": "4.18.0",
    "tailwindcss": "4.2.1",
    "tw-animate-css": "1.4.0",
    "typescript": "5.9.3",
    "vite": "^8.1.0"
  }
