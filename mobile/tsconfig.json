{
  "compilerOptions": {
    "target": "ES2022", "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext", "moduleResolution": "Bundler", "jsx": "react-jsx",
    "strict": true, "noEmit": true, "skipLibCheck": true,
    "allowJs": true, "esModuleInterop": true, "resolveJsonModule": true,
    "types": ["vite/client", "node"],
    "paths": {
      "@/lib/calendar-time": ["./src/calendar-display.ts"],
      "@/*": ["../web/*"], "next/link": ["./src/link.tsx"],
      "react": ["./node_modules/@types/react"], "react/*": ["./node_modules/@types/react/*"],
      "react-dom": ["./node_modules/@types/react-dom"], "react-dom/*": ["./node_modules/@types/react-dom/*"]
    }
  },
  "include": ["src", "vite.config.ts", "capacitor.config.ts", "playwright.config.ts"]
}
