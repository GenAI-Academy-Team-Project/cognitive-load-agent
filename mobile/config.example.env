# Public origin only. Never put Google, Cloudflare or other secrets here.
# Copy this file to .env.local in this directory.
VITE_CARESTEAD_API_ORIGIN=https://carestead.example.com
# Optional localhost backend for browser development; ignored by the native app.
CARESTEAD_DEV_API_ORIGIN=http://127.0.0.1:8080
# For an iPhone connected to a Mac-hosted backend through the mobile gateway:
VITE_CARESTEAD_LOCAL_BACKEND=0
CARESTEAD_MAC_BACKEND_ORIGIN=http://127.0.0.1:8080
